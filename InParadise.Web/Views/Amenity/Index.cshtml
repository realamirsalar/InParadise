@model IEnumerable<Amenity>
@{
}
<h1 class="f-pinar text-primary text-center my-5"> لیست امکانات رفاهی </h1>

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <p class=" my-2">در اینجا میتواند لیست امکانات رفاهی را مشاهده کنید</p>
        <a class="btn btn-primary" asp-controller="Amenity" asp-action="Create"><i class="bi bi-plus-circle fs-5 pe-2"></i>افزودن امکان رفاهی جدید</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
            <tr>
                <td class="bg-secondary">شناسه</td>
                <td class="bg-secondary">نام</td>
                <td class="bg-secondary">نام ویلا</td>
                <td class="bg-secondary">عملیات</td>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Villa.Name</td>
                    <td>
                        <a asp-controller="Amenity" asp-action="Update" asp-route-amenityId="@item.Id" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil-square"></i> ویرایش
                        </a>
                        <a asp-controller="Amenity" asp-action="Delete" asp-route-amenityId="@item.Id" class="btn btn-sm btn-danger">
                            <i class="bi bi-trash-fill"></i> حذف
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>