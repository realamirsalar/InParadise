@model IEnumerable<InParadise.Domain.Entities.Villa>
@{
}
<h1 class="f-pinar text-primary mt-5"> لیست ویلاها </h1>
<p class=" my-3 mb-4">در اینجا میتواند لیست ویلا ها را مشاهده کنید</p>
<table class="table table-bordered">
    <thead>
        <tr>
            <td class="bg-secondary">نام</td>
            <td class="bg-secondary">قیمت</td>
            <td class="bg-secondary">متراژ</td>
            <td class="bg-secondary">ظرفیت</td>
    </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Sqft</td>
                <td>@item.Occupancy</td>
            </tr>
        }
    </tbody>
</table>