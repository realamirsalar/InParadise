@model IEnumerable<InParadise.Domain.Entities.Villa>
@{
}
<h1 class="f-pinar text-primary text-center my-5"> لیست ویلاها </h1>

<div class="card">
    <div class="card-header d-flex justify-content-between">
        <p class=" my-2">در اینجا میتواند لیست ویلا ها را مشاهده کنید</p>
        <a class="btn btn-primary" asp-controller="Villa" asp-action="Create"><i class="bi bi-plus-circle fs-5 pe-2"></i>افزودن ویلای جدید</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered">
            <thead>
            <tr>
                <td class="bg-secondary">نام</td>
                <td class="bg-secondary">قیمت</td>
                <td class="bg-secondary">متراژ</td>
                <td class="bg-secondary">ظرفیت</td>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price</td>
                    <td>@item.Sqft</td>
                    <td>@item.Occupancy</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>