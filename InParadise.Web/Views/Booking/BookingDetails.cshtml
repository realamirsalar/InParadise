
@model Booking

<div class="row m-3">
    <div class="col-lg-6 p-3 border border-light border-1 border-end-0">
        <div class="d-flex justify-content-between pb-3 border-bottom">
            <h3 class="text-primary f-pinar">جزییات ویلا</h3>
            <a asp-controller="Booking" asp-action="Index" class="btn btn-secondary">بازکشت به لیست سفارشات</a>
        </div>
        <div class=" py-3">
            <partial name="_VillaDetail" model="@Model.Villa" />
            <h4 class="f-pinar text-danger text-end">جمع کل :
                <span class="" style="border-bottom:1px solid #ff6a00">@Model.TotalCost</span>
                تومان</h4>
        </div>
    </div>
    <div class="col-lg-6 p-3 border border-light border-1">
       
        <form method="post">
            <input asp-for="Id" hidden />
            <input asp-for="VillaId" hidden />
            <input asp-for="UserId" hidden />
            <input asp-for="CheckInDate" hidden />
            <input asp-for="CheckOutDate" hidden />
            <input asp-for="Nights" hidden /> 
            <div class="d-flex justify-content-between pb-3 border-bottom">
                <h3 class="text-primary f-pinar">جزییات ویلا</h3>
                @if ((Model.Status == SD.StatusApproved || Model.Status == SD.StatusPending) && User.IsInRole(SD.AdminRole))
                {
                    <button type="submit" class="btn w-50 btn-outline-danger" asp-controller="Booking" asp-action="CancelBooking">
                        <i class="bi bi-x-circle"></i>&nbsp;لغو سفارش
                    </button>
                }
            </div>
            <div class="row">
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">نام و نام خانوادگی</label>
                    <input asp-for="Name" class="form-control"/>
                </div>
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">شماره موبایل</label>
                    <input asp-for="Phone" class="form-control"/>
                </div>
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">پست الکترونیک</label>
                    <input asp-for="Email" class="form-control"/>
                </div>

                <div class="form-group pt-2 col-6">
                    <label class="text-warning">تعداد شب</label>
                    <input asp-for="Nights" disabled class="form-control"/>
                </div>
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">وضعیت</label>
                    <input asp-for="Status" disabled class="form-control"/>
                </div>
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">تاریخ سفارش</label>
                    <input asp-for="BookingDate" disabled class="form-control"/>
                </div>
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">تاریخ ثبت رزرو</label>
                    <input asp-for="CheckInDate" disabled class="form-control"/>
                </div>
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">تاریخ ورود </label>
                    <input asp-for="ActualCheckInDate" disabled class="form-control"/>
                </div>

                <div class="form-group pt-2 col-6">
                    <label class="text-warning">تاریخ اتملم روزو </label>
                    <input asp-for="CheckOutDate" disabled class="form-control"/>
                </div>
                <div class="form-group pt-2 col-6">
                    <label class="text-warning">تاریخ خروج</label>
                    <input asp-for="ActualCheckOutDate" disabled class="form-control"/>
                </div>

                @if (Model.Status == SD.StatusApproved && User.IsInRole(SD.AdminRole))
                {
                    <div class="form-group pt-2 col-6">
                        <label class="text-danger" asp-for="VillaNumber">شماره ویلا</label>
                        <select class="form-select" asp-for="VillaNumber">
                            @foreach (var villaNumber in Model.VillaNumbers)
                            {
                                <option value="@villaNumber.NumberOfVilla">@villaNumber.NumberOfVilla</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input asp-for="VillaNumber" hidden />
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">شماره ویلا</label>
                        <input asp-for="VillaNumber" disabled class="form-control"/>
                    </div>
                }
                @if (Model.IsPaymentSuccessful)
                {
                    if (User.IsInRole(SD.AdminRole))
                    {
                        <div class="form-group pt-2 col-6">
                            <label class="text-warning">شناسه یکتای پرداخت</label>
                            <input asp-for="Authority" disabled class="form-control"/>
                        </div>
                    }

                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">کد رهگیری پرداخت</label>
                        <input asp-for="RefId" disabled class="form-control"/>
                    </div>
                    <div class="form-group pt-2 col-6">
                        <label class="text-warning">تاریخ پرداخت</label>
                        <input asp-for="PaymentDate" disabled class="form-control"/>
                    </div>
                }
            </div>
            @if (User.IsInRole(SD.AdminRole))
            {
                @if (Model.Status == SD.StatusApproved)
                {
                    <button type="submit" asp-controller="Booking" asp-action="CheckIn"
                            class="btn btn-warning form-control my-2">
                        <i class="bi bi-check2-square"></i> &nbsp; ثبت ورود مهمان
                    </button>
                }

                @if (Model.Status == SD.StatusCheckedIn)
                {
                    <button type="submit" asp-controller="Booking" asp-action="CheckOut"
                            class="btn btn-success form-control my-2">
                        <i class="bi bi-clipboard2-check"></i> &nbsp; Check Out / Complete Booking
                    </button>
                }
            }
        </form>
    </div>
</div>