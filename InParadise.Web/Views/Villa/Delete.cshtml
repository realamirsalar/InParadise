@model Villa


<h1 class="f-pinar text-primary text-center my-5">ویرایش ویلا </h1>
<div class="card">
    <div class="card-header d-flex justify-content-between">
        <p class=" my-2">در اینجا میتواند اطلاعات ویلا را ویرایش کنید</p>
    </div>
    <div class="card-body">
        <form method="post" class="row">
            <input asp-for="Id" hidden />
            <div class="p-3">
                <div class="form-floating py-1">
                    <input asp-for="Name" disabled class="form-control" />
                    <label asp-for="Name" class="mt-1">نام ویلا</label>
                </div>
                <div class="form-floating py-1">
                    <input asp-for="Description" disabled class="form-control" />
                    <label asp-for="Description" class="mt-1">توضیحات</label>
                </div>
                <div class="form-floating py-1">
                    <input asp-for="Price" disabled class="form-control" />
                    <label asp-for="Price" class="mt-1">قیمت ویلا</label>
                </div>
                <div class="form-floating py-1">
                    <input asp-for="Sqft" disabled class="form-control" />
                    <label asp-for="Sqft" class="mt-1">متراژ ویلا</label>
                </div>
                <div class="form-floating py-1">
                    <input asp-for="Occupancy" disabled class="form-control" />
                    <label asp-for="Occupancy" class="mt-1">ظرفیت ویلا</label>
                </div>
                <div class="form-floating py-1">
                    <input asp-for="ImageUrl" disabled class="form-control" />
                    <label asp-for="ImageUrl" class="mt-1">تصویر ویلا</label>
                </div>
                <div class="pt-2 row">
                    <div class="col-6 col-md-3">
                        <button class="btn btn-danger w-100" type="submit">
                            حذف <i class="bi bi-trash-fill fs-6 pe-2"></i>
                        </button>
                    </div>
                    <div class="col-6 col-md-3">
                        <a asp-controller="Villa" asp-action="Index" class="btn btn-secondary w-100">
                            بازگشت <i class="bi bi-x-circle fs-6 pe-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </form>

    </div>
</div>


