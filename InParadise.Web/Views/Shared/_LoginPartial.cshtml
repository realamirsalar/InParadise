@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> _userManager;
@inject SignInManager<ApplicationUser> _signInManager;


<ul class="navbar-nav">
    @if (_signInManager.IsSignedIn(User))
    {
    <li class="nav-item">
        <a class="nav-link" href="#">سلام @_userManager.GetUserName(User)</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Register">خروج</a>
        </li>
    }
    else
    {
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Register">ثبت نام</a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-controller="Account" asp-action="Login">ورود </a>
        </li>

    }
</ul>